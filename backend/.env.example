# Database
DB_URL=jdbc:postgresql://localhost:5432/thrift_auction
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Server
PORT=8080

# Development seed users only (seeders are disabled in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=

# Admin perimeter (required in production)
ADMIN_ALLOWED_IPS=127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1

# Google OAuth
GOOGLE_CLIENT_ID=

# Security
CORS_ALLOWED_ORIGINS=https://thriftly.vn
SESSION_COOKIE_NAME=THRIFTLY_SESSION
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=Lax
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# Redis-backed browser sessions
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
SESSION_REDIS_NAMESPACE=thriftly:session

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL_NAME=llama3-8b-8192

# GHN
GHN_TOKEN=
GHN_SHOP_ID=
GHN_WEBHOOK_SECRET=
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/create
GHN_ORDER_CREATION_ENABLED=false
GHN_DEFAULT_SHIPPING_FEE=35000

# Frontend
FRONTEND_URL=https://thriftly.vn
