# Browser-visible API and WebSocket URLs (baked into the Next.js bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Server-side Next.js SSR API URL (in Docker Compose: http://backend:8080/api/v1)
INTERNAL_API_URL=http://localhost:8081/api/v1

# Public third-party client IDs (safe for browser bundle; never put secrets here)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
